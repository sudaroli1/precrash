__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# Data and outputs are never committed. Manifests in data/*.csv ARE committed:
# they are small, and they are what makes the evaluation reproducible.
features/
results/
data/Test/
data/train/
data/*.zip
*.npz

# LaTeX build products. main.pdf and main.bbl ARE committed: the PDF is the
# submission file and the .bbl lets the paper build without a BibTeX run.
latex/*.aux
latex/*.blg
latex/*.out
latex/*.toc
latex/*.log
