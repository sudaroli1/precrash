__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# Data and outputs are never committed. Manifests in data/*.csv ARE committed:
# they are small, and they are what makes the evaluation reproducible.
features/
results/
data/Test/
data/train/
data/*.zip
*.npz

# Working copies of the manuscript that predate the corrections.
# These still assert the withdrawn claims (the 90%/RAFT figure, the six-frame
# gain, three independent engines, an NLP captioning model) and must never be
# committed: paper/Precrash.docx is the current manuscript.
paper/cur.md
paper/orig.md
paper/unp*/
paper/*.bak

# The Mendeley Data deposit is built from submissions/ and scripts/, which are
# already here. The archival copy is doi:10.17632/yjvr5c7v3n.1 -- do not carry
# a second one in git, where it would drift from the published version.
precrash_data.zip
nexar/out/extract.log

# Competition data and labels are NOT redistributed. The paper states this in
# its compliance section, and both the zero-shot-taa and Nexar competitions
# prohibit redistribution, so these must never be committed again:
#   data/test.csv       the organisers' metadata, including the captions, which
#                       describe outcomes and therefore leak the answer
#   data/nexar_*.csv    splits carrying Nexar's label/onset/alert columns
#   nexar/out/manifest.csv  the same labels, resolved to frame indices
# All of them are regenerated from the user's own copy of each dataset:
# manifest.csv by nexar/prep.py, the splits by nexar/split.py (fixed seed).
data/test.csv
data/nexar_*.csv
nexar/out/manifest.csv

# Build leftovers
tits/aap_latex_source/
tits/*.aux
tits/*.log
tits/*.out
tits/*.bbl
tits/*.blg
tits/new/
